<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Equipe de May Gourmet</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/modal.css">
    <!--Il faut pas oublier le defer-->
    <script src="/javascript/script.js" defer></script>
</head>
<body>
 <%- include('navbar') -%>

    <h1>Mon equipe de choc</h1>
    <br>
     <button id="myBtn">Ajouter un membre</button>

    <div class="conteneur-equipe">
        <% resultatEquipe.forEach(resultat => { %>
            <div class="card">
                <img src="/images/avatar1.png" alt="Avatar" style="width:65%">
                <div class="container">
                    <h4><b><%= resultat.nom %> <%= resultat.prenom %></b></h4>
                    <p class="cc"> <%= resultat.poste %> </p> <br>
                    <input type="button" value="modifier" class="boutonModifier" onclick='modifier(<%- JSON.stringify([resultat.id, resultat.nom, resultat.prenom, resultat.mail, resultat.telephone, resultat.poste, resultat.adresse_postale, resultat.presentation, resultat.date_recrutement]) %>)' >
                    <input type="button" value="supprimer" onclick="supprimer('<%=resultat.id %>')">
                    

                </div>
            </div>
        <% }) %>
    </div>

    <h2></h2>


<div id="myModal" class="modal">

  <div class="modal-content">
    <div class="modal-header">
      <span class="close">&times;</span>
      <h2>Bienvenue</h2>
    </div>
    <div class="modal-body">
      <p>Enregistrer une nouvelle personne</p>
      <p>Formulaire d'inscription</p>


      <div class="container">
        <!--Il faut créer un API post equipe dans app.js-->
  <form action="/api/equipe" method="post"> 
    <input type="hidden" id="id" name="id">
    <div class="row">
      <!--div class row créer une bordure pour le formulaire-->
      <div class="col-25">
        <label for="nom">Nom :</label>
      </div>
      <div class="col-75">
        <input type="text" id="nom" name="nom" placeholder="Votre nom">
      </div>
    </div>
    <div class="row">
      <div class="col-25">
        <label for="prenom">Prenom :</label>
      </div>
      <div class="col-75">
        <input type="text" id="prenom" name="prenom" placeholder="Votre prenom">
      </div>
    </div>
    <div class="row">
      <div class="col-25">
        <label for="mail">Mail :</label>
      </div>
      <div class="col-75">
        <input type="email" id="mail" name="mail" placeholder="Votre mail">
      </div>
    </div>
    <div class="row">
      <div class="col-25">
        <label for="telephone">Telephone :</label>
      </div>
      <div class="col-75">
        <input type="number" id="telephone" name="telephone" placeholder="Votre numero">
      </div>
    </div>
    <div class="row">
      <div class="col-25">
        <label for="poste">Poste :</label>
      </div>
      <div class="col-75">
        <input type="text" id="poste" name="poste" placeholder="Votre poste">
      </div>
    </div>
    <div class="row">
      <div class="col-25">
        <label for="a_postale">Adresse postale :</label>
      </div>
      <div class="col-75">
        <input type="text" id="a_postale" name="a_postale" placeholder="Votre adresse postale">
      </div>
    </div>
    
    <div class="row">
      <div class="col-25">
        <label for="presentation">Présentation</label>
      </div>
      <div class="col-75">
        <textarea id="presentation" name="presentation" placeholder="A propos de vous" style="height:200px"></textarea>
      </div>
    </div>
    <div class="row">
      <input type="submit" value="Enregistrer">
    </div>
    <div class="row">
      <div class="col-25">
        <label for="d_recrutement">Date de recrutement :</label>
      </div>
      <div class="col-75">
        <input type="date" id="d_recrutement" name="d_recrutement" placeholder="Votre date de recrutement">
      </div>
    </div>
  </form>

</div>
    </div>
    <div class="modal-footer">
      <button>Enregistrer</button>
    </div>
  </div>

</div>

    
</body>
</html>